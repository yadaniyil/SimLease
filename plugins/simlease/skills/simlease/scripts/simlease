#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PROJECT_ROOT="${SIMLEASE_WORKSPACE:-$(pwd -P)}"
LEASE_ROOT="${SIMLEASE_DIR:-${TMPDIR:-/tmp}/simlease}"
LOCK_DIR="${LEASE_ROOT}/locks"
LEASE_DIR="${LEASE_ROOT}/leases"
SIGNAL_DIR="${LEASE_ROOT}/signals"
HANDSHAKE_DIR="${LEASE_ROOT}/handshakes"
DERIVED_DATA_ROOT="${LEASE_ROOT}/derived-data"
RUNTIME_ROOT="${SIMLEASE_RUNTIME_DIR:-${TMPDIR:-/tmp}/simlease-runtime}"
POOL_LOCK_PATH="${LOCK_DIR}/pool.lock"
SERVE_SIM_STATE_DIR="${SIMLEASE_SERVE_SIM_STATE_DIR:-${TMPDIR:-/tmp}/serve-sim}"
DEFAULT_TTL_SECONDS="${SIMLEASE_TTL_SECONDS:-3600}"
MIN_FREE_MEMORY_MB="${SIMLEASE_MIN_FREE_MEMORY_MB:-4096}"
MIN_FREE_MEMORY_PERCENT="${SIMLEASE_MIN_FREE_MEMORY_PERCENT:-15}"
CONFIG_DIR="${SIMLEASE_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/simlease}"
# One simslim profile for every project: a Simulator slimmed for one project must
# still run every other project's app.
SIMSLIM_PROFILE="${SIMLEASE_SIMSLIM_PROFILE:-${CONFIG_DIR}/simslim-profile.json}"
DEFAULT_SIMSLIM_EXCEPT='photos,store,icloud,web'
# Simulators with state worth keeping (signed in, seeded media). Automatic picks
# skip them; `--device <UDID>` still leases one.
PINNED_FILE="${SIMLEASE_PINNED_FILE:-${CONFIG_DIR}/pinned}"
ANDROID_SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-${HOME}/Library/Android/sdk}}"
ANDROID_FIRST_PORT="${SIMLEASE_ANDROID_FIRST_PORT:-5560}"
ANDROID_LAST_PORT="${SIMLEASE_ANDROID_LAST_PORT:-5680}"
ANDROID_BOOT_TIMEOUT_SECONDS="${SIMLEASE_ANDROID_BOOT_TIMEOUT_SECONDS:-420}"
SIMLEASE_VERSION="0.3.1"
# simslim 0.6.0 added `verify` (older versions re-slim on every lease), and
# 0.6.1 keeps StoreKit working with `--except store`. 0.11 re-slims a booted
# Simulator in about 17 s.
SIMSLIM_MIN_VERSION="0.6.1"
SIMSLIM_FAST_VERSION="0.11.0"

usage() {
    cat <<'EOF'
Usage:
  simlease acquire --owner NAME [options]                 iOS Simulator
  simlease acquire --android --avd NAME --owner NAME [options]   Android emulator
  simlease status [--json]
  simlease renew --token TOKEN [--ttl SECONDS] [--json]
  simlease release --token TOKEN [--json]
  simlease exec --token TOKEN -- COMMAND [ARG ...]

renew, release and exec also take --token-file PATH in place of --token TOKEN.
exec keeps renewing the lease while COMMAND runs, so a long run outlives the TTL.
exec exports SIMULATOR_UDID, SIMULATOR_NAME and DERIVED_DATA_PATH for a Simulator,
or ANDROID_SERIAL, ANDROID_AVD_NAME, ANDROID_EMULATOR_PORT and
ANDROID_EMULATOR_GRPC_PORT for an emulator.

Acquire options:
  --owner NAME       Required task or agent identifier.
  --purpose TEXT     Short description shown in lease status.
  --ttl SECONDS      Lease lifetime; defaults to 3600 seconds.
  --wait SECONDS     Wait for a device; defaults to 0.
  --token-file PATH  Also write the token to PATH (mode 600). Refuses a file that
                     still holds an active lease's token.
  --json             Emit machine-readable JSON.
Simulator options:
  --device UUID      Claim only this simulator (the only way to lease a pinned one).
  --boot-if-needed   Boot one additional Simulator when the pool is busy and memory permits.
  --keep-services C  simslim categories this lease also needs running, on top of
                     the shared profile (e.g. widgets,siri).
Emulator options:
  --android          Lease an Android emulator: simlease boots a fresh instance of
                     the AVD on a free port and stops it on release or expiry.
  --avd NAME         The AVD to boot (implies --android; default SIMLEASE_ANDROID_AVD).
  --writable         Boot the AVD writable (default read-only, which lets many
                     leases share one AVD and never changes it). Waits until no
                     other instance of that AVD runs, under any of its names.
  --window           Show the emulator window (default headless).
  --emulator-args A  Extra emulator flags, e.g. "-camera-back emulated -gpu swiftshader_indirect".

Every leased Simulator is slimmed with simslim (0.6.1 or newer; 0.11 is much
faster). `scripts/preflight` checks the version. The shared profile is
~/.config/simlease/simslim-profile.json ({"except": [...], "keep": [...]}; default
except: photos,store,icloud,web). SIMLEASE_SLIM=0 turns slimming off.
~/.config/simlease/pinned lists Simulator UDIDs automatic picks skip.

SIMLEASE_DIR overrides the shared state directory.
SIMLEASE_WORKSPACE overrides the workspace recorded in lease metadata.
SIMLEASE_DEVICES may contain test-only TSV device rows.
SIMLEASE_MIN_FREE_MEMORY_MB defaults to 4096.
SIMLEASE_MIN_FREE_MEMORY_PERCENT defaults to 15.
SIMLEASE_MAX_BOOTED_SIMULATORS overrides the RAM-derived pool cap (6 slim Simulators on 64 GB).
SIMLEASE_MAX_EMULATORS overrides the emulator cap (4 on 64 GB).
EOF
}

fail() {
    printf 'simlease: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command '$1' is unavailable"
}

require_nonnegative_integer() {
    case "$2" in
        ''|*[!0-9]*) fail "$1 must be a non-negative integer" ;;
    esac
}

require_positive_integer() {
    require_nonnegative_integer "$1" "$2"
    [[ "$2" -gt 0 ]] || fail "$1 must be greater than zero"
}

launchd_job_is_loaded() {
    local label="$1"
    [[ -n "$label" ]] || return 1
    launchctl list "$label" >/dev/null 2>&1
}

launchd_job_is_running() {
    local label="$1"
    launchctl list "$label" 2>/dev/null |
        awk '/"PID"[[:space:]]*=[[:space:]]*[0-9]+;/ { running=1 } END { exit !running }'
}

remove_launchd_job() {
    local label="$1"
    [[ -n "$label" ]] || return 0
    launchctl remove "$label" >/dev/null 2>&1 || true
}

metadata_guard_is_alive() {
    local metadata="$1"
    local guard_label
    local guard_pid

    guard_label="$(jq -r '.guardLabel // empty' "$metadata" 2>/dev/null || true)"
    if [[ -n "$guard_label" ]]; then
        launchd_job_is_running "$guard_label"
        return
    fi

    # Schema v2 leases predate launchd ownership. Keep recognizing them until
    # they expire or are released so upgrades do not invalidate active work.
    guard_pid="$(jq -r '.guardPid // 0' "$metadata" 2>/dev/null || printf '0')"
    [[ "$guard_pid" =~ ^[0-9]+$ ]] && [[ "$guard_pid" -gt 1 ]] && kill -0 "$guard_pid" 2>/dev/null
}

initialize_directories() {
    mkdir -p "$LOCK_DIR" "$LEASE_DIR" "$SIGNAL_DIR" "$HANDSHAKE_DIR" "$DERIVED_DATA_ROOT" "$RUNTIME_ROOT"
    chmod 700 "$LEASE_ROOT" "$LOCK_DIR" "$LEASE_DIR" "$SIGNAL_DIR" "$HANDSHAKE_DIR" "$DERIVED_DATA_ROOT" "$RUNTIME_ROOT" 2>/dev/null || true
}

install_runtime_script() {
    local script_digest
    local runtime_script
    local temporary

    script_digest="$(shasum -a 256 "$SCRIPT_PATH" | awk '{print substr($1, 1, 16)}')"
    runtime_script="${RUNTIME_ROOT}/simlease-${SIMLEASE_VERSION}-${script_digest}"
    if [[ ! -x "$runtime_script" ]]; then
        temporary="${runtime_script}.tmp.$$"
        install -m 0700 "$SCRIPT_PATH" "$temporary"
        mv "$temporary" "$runtime_script"
    fi
    printf '%s\n' "$runtime_script"
}

token_hash() {
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
}

utc_timestamp() {
    date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ'
}

workspace_key() {
    printf '%s' "$PROJECT_ROOT" | shasum -a 256 | awk '{print substr($1, 1, 12)}'
}

booted_devices() {
    if [[ -n "${SIMLEASE_DEVICES:-}" ]]; then
        printf '%s\n' "$SIMLEASE_DEVICES"
        test_booted_devices
        return
    fi

    require_command xcrun
    xcrun simctl list devices booted -j |
        jq -r '.devices | to_entries[] | .value[] | select(.state == "Booted" and .isAvailable == true) | [.udid, .name] | @tsv'
}

test_booted_devices() {
    local marker
    local udid
    local device_name
    [[ -n "${SIMLEASE_TEST_DEVICE_STATE_DIR:-}" ]] || return 0
    for marker in "${SIMLEASE_TEST_DEVICE_STATE_DIR}"/*.booted; do
        [[ -f "$marker" ]] || continue
        udid="$(basename "$marker" .booted)"
        device_name="$(printf '%s\n' "${SIMLEASE_SHUTDOWN_DEVICES:-}" | awk -F '\t' -v wanted="$udid" '$1 == wanted {print $2; exit}')"
        [[ -n "$device_name" ]] && printf '%s\t%s\n' "$udid" "$device_name"
    done
}

shutdown_devices() {
    local runtime_identifier
    if [[ -n "${SIMLEASE_SHUTDOWN_DEVICES:-}" ]]; then
        if [[ -z "${SIMLEASE_TEST_DEVICE_STATE_DIR:-}" ]]; then
            printf '%s\n' "$SIMLEASE_SHUTDOWN_DEVICES"
            return
        fi
        while IFS=$'\t' read -r udid device_name; do
            [[ -n "$udid" ]] || continue
            [[ -f "${SIMLEASE_TEST_DEVICE_STATE_DIR}/${udid}.booted" ]] || printf '%s\t%s\n' "$udid" "$device_name"
        done <<< "$SIMLEASE_SHUTDOWN_DEVICES"
        return
    fi

    require_command xcrun
    runtime_identifier="$(xcrun simctl list runtimes available -j | jq -r '
        [.runtimes[] | select(.isAvailable != false and (.identifier | test("SimRuntime.iOS-")))]
        | sort_by(.version | split(".") | map(tonumber)) | last | .identifier // empty')"
    [[ -n "$runtime_identifier" ]] || return 0
    xcrun simctl list devices -j | jq -r --arg runtime "$runtime_identifier" '
        .devices[$runtime][]?
        | select(.state == "Shutdown" and .isAvailable == true)
        | [.udid, .name] | @tsv'
}

is_android_id() {
    [[ "$1" == emulator-* ]]
}

android_tool() {
    case "$1" in
        adb) printf '%s\n' "${SIMLEASE_ADB:-${ANDROID_SDK}/platform-tools/adb}" ;;
        emulator) printf '%s\n' "${SIMLEASE_EMULATOR:-${ANDROID_SDK}/emulator/emulator}" ;;
    esac
}

android_avds() {
    if [[ -n "${SIMLEASE_ANDROID_AVDS:-}" ]]; then
        printf '%s\n' "$SIMLEASE_ANDROID_AVDS"
        return
    fi
    "$(android_tool emulator)" -list-avds 2>/dev/null | awk 'NF && $0 !~ /^INFO/'
}

android_port_in_use() {
    local port="$1"
    if [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]]; then
        [[ -f "${SIMLEASE_ANDROID_TEST_STATE_DIR}/emulator-${port}.running" ]]
        return
    fi
    # Console port, adb port (port+1) and gRPC port (port+3000) must all be free.
    lsof -nP -iTCP:"$port" -iTCP:"$(( port + 1 ))" -iTCP:"$(( port + 3000 ))" -sTCP:LISTEN >/dev/null 2>&1
}

android_running_count() {
    if [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]]; then
        find "$SIMLEASE_ANDROID_TEST_STATE_DIR" -name 'emulator-*.running' 2>/dev/null | awk 'END {print NR}'
        return
    fi
    "$(android_tool adb)" devices 2>/dev/null | awk '$1 ~ /^emulator-/ {count++} END {print count+0}'
}

# The AVD folder an .ini file points at (its path= line), or nothing.
android_avd_ini_folder() {
    local folder
    folder="$(sed -n 's/^path=//p' "$1" 2>/dev/null | head -n 1 || true)"
    folder="${folder%/}"
    [[ -n "$folder" ]] || return 0
    # The real folder when it exists, so a symlinked path still matches.
    (cd "$folder" 2>/dev/null && pwd -P) || printf '%s\n' "$folder"
}

# Every name of an AVD, the given one first. A second .ini with the same path=
# gives an AVD folder a second name, and the emulator boots it under either.
android_avd_names() {
    local avd="$1"
    local avd_home="${ANDROID_AVD_HOME:-${HOME}/.android/avd}"
    local folder
    local ini
    printf '%s\n' "$avd"
    folder="$(android_avd_ini_folder "${avd_home}/${avd}.ini")"
    [[ -n "$folder" ]] || return 0
    for ini in "$avd_home"/*.ini; do
        [[ -f "$ini" && "$ini" != "${avd_home}/${avd}.ini" ]] || continue
        [[ "$(android_avd_ini_folder "$ini")" != "$folder" ]] || basename "$ini" .ini
    done
}

# Prints the name a running instance of the AVD was started under, if one runs.
android_avd_running_as() {
    local name
    while IFS= read -r name; do
        if [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]]; then
            grep -qx -- "$name" "${SIMLEASE_ANDROID_TEST_STATE_DIR}"/*.running 2>/dev/null || continue
        else
            pgrep -f -- "qemu-system.* -avd ${name}( |$)" >/dev/null 2>&1 \
                || pgrep -f -- "emulator.* -avd ${name}( |$)" >/dev/null 2>&1 || continue
        fi
        printf '%s\n' "$name"
        return 0
    done < <(android_avd_names "$1")
    return 1
}

# An AVD runs writable in one instance at most, and only when no instance runs
# under any of its names.
android_avd_is_running() {
    android_avd_running_as "$1" >/dev/null
}

android_boot() {
    local serial="$1"
    local avd="$2"
    local port="${serial#emulator-}"
    local adb
    local emulator_pid
    local deadline
    local log_file="${LEASE_ROOT}/android-logs/${serial}.log"
    local -a arguments

    if [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]]; then
        mkdir -p "$SIMLEASE_ANDROID_TEST_STATE_DIR"
        [[ "${SIMLEASE_TEST_ANDROID_BOOT_FAILS:-false}" != "true" ]] || return 1
        printf '%s\n' "$avd" > "${SIMLEASE_ANDROID_TEST_STATE_DIR}/${serial}.running"
        return 0
    fi

    mkdir -p "${LEASE_ROOT}/android-logs"
    arguments=(-avd "$avd" -port "$port" -grpc "$(( port + 3000 ))" -no-snapshot-save -no-boot-anim)
    [[ "${SIMLEASE_ANDROID_WRITABLE:-false}" == "true" ]] || arguments+=(-read-only)
    [[ "${SIMLEASE_ANDROID_WINDOW:-false}" == "true" ]] || arguments+=(-no-window)
    # Extra emulator flags (camera, GPU), split on spaces; -port and -avd stay simlease's.
    if [[ -n "${SIMLEASE_ANDROID_EXTRA_ARGS:-}" ]]; then
        # shellcheck disable=SC2206 # Word splitting is the point.
        arguments+=(${SIMLEASE_ANDROID_EXTRA_ARGS})
    fi
    "$(android_tool emulator)" "${arguments[@]}" > "$log_file" 2>&1 < /dev/null &
    emulator_pid=$!
    adb="$(android_tool adb)"
    deadline=$(( $(date +%s) + ANDROID_BOOT_TIMEOUT_SECONDS ))
    while [[ "$(date +%s)" -lt "$deadline" ]]; do
        kill -0 "$emulator_pid" 2>/dev/null || return 1
        if [[ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == "1" ]]; then
            return 0
        fi
        sleep 2
    done
    android_shutdown "$serial"
    return 1
}

android_shutdown() {
    local serial="$1"
    local port="${serial#emulator-}"
    local _attempt
    if [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]]; then
        rm -f "${SIMLEASE_ANDROID_TEST_STATE_DIR}/${serial}.running"
        return 0
    fi
    "$(android_tool adb)" -s "$serial" emu kill >/dev/null 2>&1 || true
    for _attempt in $(seq 1 40); do
        pgrep -f -- "qemu-system.* -port ${port}( |$)" >/dev/null 2>&1 || return 0
        sleep 0.5
    done
    pkill -f -- "qemu-system.* -port ${port}( |$)" >/dev/null 2>&1 || true
}

boot_device() {
    local udid="$1"
    if is_android_id "$udid"; then
        android_boot "$udid" "${2:-}"
        return
    fi
    if [[ -n "${SIMLEASE_TEST_DEVICE_STATE_DIR:-}" ]]; then
        mkdir -p "$SIMLEASE_TEST_DEVICE_STATE_DIR"
        sleep "${SIMLEASE_TEST_BOOT_DELAY_SECONDS:-0}"
        : > "${SIMLEASE_TEST_DEVICE_STATE_DIR}/${udid}.booted"
        return 0
    fi
    xcrun simctl bootstatus "$udid" -b
}

shutdown_device() {
    local udid="$1"
    if is_android_id "$udid"; then
        android_shutdown "$udid"
        return
    fi
    if [[ -n "${SIMLEASE_TEST_DEVICE_STATE_DIR:-}" ]]; then
        rm -f "${SIMLEASE_TEST_DEVICE_STATE_DIR}/${udid}.booted"
        return 0
    fi
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
}

total_memory_mb() {
    if [[ -n "${SIMLEASE_TEST_TOTAL_MEMORY_MB:-}" ]]; then
        printf '%s\n' "$SIMLEASE_TEST_TOTAL_MEMORY_MB"
        return
    fi
    printf '%s\n' $(( $(sysctl -n hw.memsize) / 1024 / 1024 ))
}

free_memory_percent() {
    if [[ -n "${SIMLEASE_TEST_FREE_MEMORY_PERCENT:-}" ]]; then
        printf '%s\n' "$SIMLEASE_TEST_FREE_MEMORY_PERCENT"
        return
    fi
    memory_pressure -Q 2>/dev/null | awk -F ': ' '/System-wide memory free percentage/ {gsub(/%/, "", $2); print int($2); exit}'
}

max_booted_simulators() {
    local total_mb="$1"
    if [[ -n "${SIMLEASE_MAX_BOOTED_SIMULATORS:-}" ]]; then
        printf '%s\n' "$SIMLEASE_MAX_BOOTED_SIMULATORS"
    elif slimming_enabled; then
        # Every leased Simulator is slimmed: about 0.9 GB instead of about 4 GB stock.
        if [[ "$total_mb" -lt 16384 ]]; then printf '2\n'
        elif [[ "$total_mb" -lt 32768 ]]; then printf '3\n'
        elif [[ "$total_mb" -lt 65536 ]]; then printf '4\n'
        else printf '6\n'
        fi
    elif [[ "$total_mb" -lt 16384 ]]; then
        printf '1\n'
    elif [[ "$total_mb" -lt 32768 ]]; then
        printf '2\n'
    else
        printf '3\n'
    fi
}

max_emulators() {
    local total_mb="$1"
    if [[ -n "${SIMLEASE_MAX_EMULATORS:-}" ]]; then
        printf '%s\n' "$SIMLEASE_MAX_EMULATORS"
    elif [[ "$total_mb" -lt 16384 ]]; then printf '1\n'
    elif [[ "$total_mb" -lt 32768 ]]; then printf '2\n'
    elif [[ "$total_mb" -lt 65536 ]]; then printf '3\n'
    else printf '4\n'
    fi
}

# Prints the simslim binary when leased Simulators should be slimmed. Test runs
# use fake devices, so they slim only through an explicit fake binary.
simslim_binary() {
    [[ "${SIMLEASE_SLIM:-1}" != "0" ]] || return 1
    if [[ -n "${SIMLEASE_SIMSLIM_BIN:-}" ]]; then
        printf '%s\n' "$SIMLEASE_SIMSLIM_BIN"
        return 0
    fi
    [[ -z "${SIMLEASE_DEVICES:-}" ]] || return 1
    command -v simslim
}

# Prints simslim's version, such as 0.11.0, or nothing when it can't be read.
simslim_version() {
    "$1" version 2>/dev/null | awk 'match($0, /[0-9]+\.[0-9]+(\.[0-9]+)?/) { print substr($0, RSTART, RLENGTH); exit }' || true
}

# True when version $1 is $2 or newer.
version_at_least() {
    awk -v have="$1" -v want="$2" 'BEGIN {
        split(have, h, "."); split(want, w, ".")
        for (i = 1; i <= 3; i++) if (h[i] + 0 != w[i] + 0) exit (h[i] + 0 < w[i] + 0)
        exit 0
    }'
}

# False for a simslim older than SIMSLIM_MIN_VERSION. A version that can't be
# read counts as new enough. `simslim version` takes a few milliseconds.
simslim_is_supported() {
    local version
    version="$(simslim_version "$1")"
    [[ -z "$version" ]] || version_at_least "$version" "$SIMSLIM_MIN_VERSION"
}

slimming_enabled() {
    local simslim_bin
    simslim_bin="$(simslim_binary 2>/dev/null)" || return 1
    simslim_is_supported "$simslim_bin"
}

# Preflight's simslim check: prints the version and warns when it is old.
# It never fails, because slimming is optional.
check_simslim() {
    local simslim_bin
    local version
    if [[ "${SIMLEASE_SLIM:-1}" == "0" ]]; then
        printf 'simslim: slimming is off (SIMLEASE_SLIM=0)\n'
        return 0
    fi
    if ! simslim_bin="$(simslim_binary 2>/dev/null)"; then
        printf 'simslim: not installed, so leased Simulators run stock. Optional: brew install mobai-app/tap/simslim\n'
        return 0
    fi
    version="$(simslim_version "$simslim_bin")"
    if [[ -z "$version" ]]; then
        printf 'simslim: could not read the version of %s\n' "$simslim_bin" >&2
    elif ! version_at_least "$version" "$SIMSLIM_MIN_VERSION"; then
        printf 'simslim %s is unsupported: SimLease needs %s or newer, so it will not slim Simulators. Run: brew upgrade simslim\n' \
            "$version" "$SIMSLIM_MIN_VERSION" >&2
    elif ! version_at_least "$version" "$SIMSLIM_FAST_VERSION"; then
        printf 'simslim %s works, but 0.11 or newer slims much faster. Run: brew upgrade simslim\n' "$version" >&2
    else
        printf 'simslim %s\n' "$version"
    fi
}

# The service categories a lease keeps running: the shared profile's "except"
# list plus this lease's --keep-services.
kept_services() {
    local base="$DEFAULT_SIMSLIM_EXCEPT"
    if [[ -f "$SIMSLIM_PROFILE" ]]; then
        base="$(jq -r '(.except // []) | join(",")' "$SIMSLIM_PROFILE" 2>/dev/null || printf '%s' "$DEFAULT_SIMSLIM_EXCEPT")"
    fi
    printf '%s,%s\n' "$base" "${SIMLEASE_KEEP_SERVICES:-}" | tr ',' '\n' \
        | awk '{ gsub(/[[:space:]]/, "") } NF && !seen[$0]++' | paste -sd ',' -
}

# Fails before leasing when --keep-services names a category simslim doesn't know.
check_keep_services() {
    local wanted="${SIMLEASE_KEEP_SERVICES:-}"
    local simslim_bin
    local category
    local -a categories

    wanted="${wanted//[[:space:]]/}"
    [[ -n "${wanted//,/}" ]] || return 0
    slimming_enabled || return 0
    simslim_bin="$(simslim_binary)"
    IFS=',' read -r -a categories <<< "$wanted"
    for category in "${categories[@]}"; do
        [[ -n "$category" ]] || continue
        "$simslim_bin" profiles "$category" >/dev/null 2>&1 \
            || fail "unknown --keep-services category '${category}'; simslim profiles lists them"
    done
}

# Makes a leased, booted Simulator match the shared profile (plus this lease's
# --keep-services) and prints the outcome: verified (already matched), applied
# (reconfigured and rebooted), failed, unsupported (simslim too old), or off.
ensure_slim() {
    local udid="$1"
    local device_name="$2"
    local simslim_bin
    local version
    local timing='about 10-25 s'
    local kept
    local kept_daemons=""
    local simslim_errors
    local -a arguments

    simslim_bin="$(simslim_binary)" || { printf 'off\n'; return 0; }
    version="$(simslim_version "$simslim_bin")"
    if [[ -n "$version" ]] && ! version_at_least "$version" "$SIMSLIM_MIN_VERSION"; then
        printf 'simlease: simslim %s is too old (SimLease needs %s or newer), so %s is not slimmed. Run: brew upgrade simslim\n' \
            "$version" "$SIMSLIM_MIN_VERSION" "$device_name" >&2
        printf 'unsupported\n'
        return 0
    fi
    # The 10-25 s holds from simslim 0.11. Older versions take longer.
    if [[ -n "$version" ]] && ! version_at_least "$version" "$SIMSLIM_FAST_VERSION"; then
        timing="simslim ${version} is slow; 0.11 or newer takes about 10-25 s"
    fi
    kept="$(kept_services)"
    arguments=(--except "$kept")
    if [[ -f "$SIMSLIM_PROFILE" ]]; then
        kept_daemons="$(jq -r '(.keep // []) | join(",")' "$SIMSLIM_PROFILE" 2>/dev/null || true)"
    fi
    [[ -z "$kept_daemons" ]] || arguments+=(--keep "$kept_daemons")
    if "$simslim_bin" verify "$udid" "${arguments[@]}" >/dev/null 2>&1; then
        printf 'verified\n'
        return 0
    fi
    printf 'simlease: slimming %s, keeping %s (%s)\n' "$device_name" "$kept" "$timing" >&2
    if simslim_errors="$("$simslim_bin" on "$udid" "${arguments[@]}" 2>&1 >/dev/null)"; then
        printf 'applied\n'
        return 0
    fi
    printf 'simlease: simslim could not slim %s; it keeps its previous profile\n' "$device_name" >&2
    simslim_errors="$(printf '%s\n' "$simslim_errors" | awk 'NF { line = $0 } END { print line }')"
    [[ -z "$simslim_errors" ]] || printf 'simlease: simslim said: %s\n' "$simslim_errors" >&2
    # simslim 0.11 shuts a booted Simulator down before it reconfigures it, so
    # a failed `on` can leave the leased Simulator shut down. Boot it again.
    boot_device "$udid" >/dev/null 2>&1 \
        || printf 'simlease: %s did not boot again; release this lease and acquire another\n' "$device_name" >&2
    printf 'failed\n'
}

is_pinned() {
    local udid="$1"
    [[ -f "$PINNED_FILE" ]] || return 1
    awk -v wanted="$udid" '{ sub(/#.*/, ""); gsub(/[[:space:]]/, "") } $0 == wanted { found=1 } END { exit !found }' "$PINNED_FILE"
}

capacity_json() {
    local platform="${1:-ios}"
    local total_mb
    local free_percent
    local free_mb
    local booted_count
    local max_booted
    local can_boot=true
    local reason='enough-memory'

    total_mb="$(total_memory_mb 2>/dev/null || printf '0')"
    free_percent="$(free_memory_percent 2>/dev/null || printf '0')"
    [[ "$total_mb" =~ ^[0-9]+$ ]] || total_mb=0
    [[ "$free_percent" =~ ^[0-9]+$ ]] || free_percent=0
    require_nonnegative_integer 'SIMLEASE_MIN_FREE_MEMORY_MB' "$MIN_FREE_MEMORY_MB"
    require_nonnegative_integer 'SIMLEASE_MIN_FREE_MEMORY_PERCENT' "$MIN_FREE_MEMORY_PERCENT"
    if [[ "$platform" == "android" ]]; then
        booted_count="$(android_running_count)"
        max_booted="$(max_emulators "$total_mb")"
        require_positive_integer 'SIMLEASE_MAX_EMULATORS' "$max_booted"
    else
        booted_count="$(booted_devices | awk 'NF {count++} END {print count+0}')"
        max_booted="$(max_booted_simulators "$total_mb")"
        require_positive_integer 'SIMLEASE_MAX_BOOTED_SIMULATORS' "$max_booted"
    fi
    free_mb=$(( total_mb * free_percent / 100 ))

    if [[ "$total_mb" -eq 0 || "$free_percent" -eq 0 ]]; then
        can_boot=false
        reason='memory-pressure-unavailable'
    elif [[ "$booted_count" -ge "$max_booted" ]]; then
        can_boot=false
        if [[ "$platform" == "android" ]]; then reason='emulator-limit'; else reason='booted-simulator-limit'; fi
    elif [[ "$free_mb" -lt "$MIN_FREE_MEMORY_MB" || "$free_percent" -lt "$MIN_FREE_MEMORY_PERCENT" ]]; then
        can_boot=false
        reason='insufficient-free-memory'
    fi

    jq -n \
        --argjson totalMemoryMB "$total_mb" \
        --argjson freeMemoryMB "$free_mb" \
        --argjson freeMemoryPercent "$free_percent" \
        --argjson bootedSimulators "$booted_count" \
        --argjson maxBootedSimulators "$max_booted" \
        --argjson canBootAnother "$can_boot" \
        --arg reason "$reason" \
        '{totalMemoryMB:$totalMemoryMB,freeMemoryMB:$freeMemoryMB,freeMemoryPercent:$freeMemoryPercent,bootedSimulators:$bootedSimulators,maxBootedSimulators:$maxBootedSimulators,canBootAnother:$canBootAnother,reason:$reason}'
}

metadata_path_for_udid() {
    printf '%s/%s.json\n' "$LEASE_DIR" "$1"
}

lock_path_for_udid() {
    printf '%s/%s.lock\n' "$LOCK_DIR" "$1"
}

probe_lock_is_free() {
    lockf -t 0 -k "$(lock_path_for_udid "$1")" true >/dev/null 2>&1
}

active_serve_sim_state() {
    local udid="$1"
    local state_file="${SERVE_SIM_STATE_DIR}/server-${udid}.json"
    local helper_pid

    [[ -f "$state_file" ]] || return 1
    helper_pid="$(jq -r '.pid // 0' "$state_file" 2>/dev/null || printf '0')"
    [[ "$helper_pid" =~ ^[0-9]+$ ]] && [[ "$helper_pid" -gt 1 ]] || return 1
    kill -0 "$helper_pid" 2>/dev/null || return 1
    jq '.' "$state_file"
}

remove_metadata_if_stale() {
    local udid="$1"
    local metadata
    local stale_token_hash
    metadata="$(metadata_path_for_udid "$udid")"
    [[ -f "$metadata" ]] || return 0

    if metadata_guard_is_alive "$metadata"; then
        return 0
    fi

    stale_token_hash="$(jq -r '.tokenHash // empty' "$metadata" 2>/dev/null || true)"
    [[ -n "$stale_token_hash" ]] || return 0
    lockf -t 0 -k "$(lock_path_for_udid "$udid")" \
        "$SCRIPT_PATH" __cleanup-stale "$udid" "$stale_token_hash" \
        >/dev/null 2>&1 || true
}

cleanup_stale_metadata_under_lock() {
    local udid="$1"
    local expected_token_hash="$2"
    local metadata
    local current_token_hash
    local guard_label
    local booted_by_simlease

    metadata="$(metadata_path_for_udid "$udid")"
    [[ -f "$metadata" ]] || return 0
    current_token_hash="$(jq -r '.tokenHash // empty' "$metadata" 2>/dev/null || true)"
    [[ "$current_token_hash" == "$expected_token_hash" ]] || return 0
    if metadata_guard_is_alive "$metadata"; then
        return 0
    fi
    guard_label="$(jq -r '.guardLabel // empty' "$metadata" 2>/dev/null || true)"
    booted_by_simlease="$(jq -r '.bootedBySimLease // false' "$metadata" 2>/dev/null || printf 'false')"
    if [[ "$booted_by_simlease" == "true" ]]; then
        shutdown_device "$udid"
    fi
    rm -f "$metadata"
    remove_launchd_job "$guard_label"
}

find_metadata_by_token_hash() {
    local wanted_hash="$1"
    local metadata
    for metadata in "$LEASE_DIR"/*.json; do
        [[ -f "$metadata" ]] || continue
        if jq -e --arg tokenHash "$wanted_hash" '.tokenHash == $tokenHash' "$metadata" >/dev/null 2>&1; then
            printf '%s\n' "$metadata"
            return 0
        fi
    done
    return 1
}

write_metadata() {
    local metadata="$1"
    local udid="$2"
    local device_name="$3"
    local owner="$4"
    local purpose="$5"
    local hashed_token="$6"
    local acquired_epoch="$7"
    local expires_epoch="$8"
    local ttl_seconds="$9"
    local lock_pid="${10}"
    local guard_pid="${11}"
    local derived_data_path="${12}"
    local booted_by_simlease="${13}"
    local lifecycle_state="${14}"
    local guard_label="${15}"
    local temporary="${metadata}.tmp.${guard_pid}"

    jq -n \
        --argjson schemaVersion 3 \
        --arg udid "$udid" \
        --arg deviceName "$device_name" \
        --arg owner "$owner" \
        --arg purpose "$purpose" \
        --arg workspace "$PROJECT_ROOT" \
        --arg tokenHash "$hashed_token" \
        --arg acquiredAt "$(utc_timestamp "$acquired_epoch")" \
        --arg expiresAt "$(utc_timestamp "$expires_epoch")" \
        --arg derivedDataPath "$derived_data_path" \
        --argjson acquiredAtEpoch "$acquired_epoch" \
        --argjson expiresAtEpoch "$expires_epoch" \
        --argjson ttlSeconds "$ttl_seconds" \
        --argjson lockPid "$lock_pid" \
        --argjson guardPid "$guard_pid" \
        --arg guardLabel "$guard_label" \
        --argjson bootedBySimLease "$booted_by_simlease" \
        --arg lifecycleState "$lifecycle_state" \
        '{
            schemaVersion: $schemaVersion,
            udid: $udid,
            deviceName: $deviceName,
            owner: $owner,
            purpose: $purpose,
            workspace: $workspace,
            tokenHash: $tokenHash,
            acquiredAt: $acquiredAt,
            acquiredAtEpoch: $acquiredAtEpoch,
            expiresAt: $expiresAt,
            expiresAtEpoch: $expiresAtEpoch,
            ttlSeconds: $ttlSeconds,
            lockPid: $lockPid,
            guardPid: $guardPid,
            guardLabel: $guardLabel,
            bootedBySimLease: $bootedBySimLease,
            lifecycleState: $lifecycleState,
            derivedDataPath: $derivedDataPath
        }' > "$temporary"
    mv "$temporary" "$metadata"
}

guard_cleanup() {
    local metadata="$1"
    local hashed_token="$2"
    local ready_file="$3"
    local acknowledged_file="$4"
    local release_file="$5"
    local udid
    local booted_by_simlease

    if [[ -f "$metadata" ]] && jq -e --arg tokenHash "$hashed_token" '.tokenHash == $tokenHash' "$metadata" >/dev/null 2>&1; then
        udid="$(jq -r '.udid' "$metadata")"
        booted_by_simlease="$(jq -r '.bootedBySimLease // false' "$metadata")"
        if [[ "$booted_by_simlease" == "true" ]]; then
            shutdown_device "$udid"
        fi
        rm -f "$metadata"
    fi
    rm -f "$ready_file" "$acknowledged_file" "$release_file"
}

guard_lease() {
    local udid="$1"
    local device_name="$2"
    local owner="$3"
    local purpose="$4"
    local hashed_token="$5"
    local acquired_epoch="$6"
    local expires_epoch="$7"
    local ttl_seconds="$8"
    local derived_data_path="$9"
    local booted_by_simlease="${10}"
    local guard_label="${11}"
    local metadata
    local ready_file="${HANDSHAKE_DIR}/${hashed_token}.ready"
    local acknowledged_file="${HANDSHAKE_DIR}/${hashed_token}.ack"
    local release_file="${SIGNAL_DIR}/${hashed_token}.release"
    local acknowledgement_deadline
    local current_expiry

    metadata="$(metadata_path_for_udid "$udid")"
    SIMLEASE_GUARD_METADATA_PATH="$metadata"
    SIMLEASE_GUARD_TOKEN_HASH="$hashed_token"
    SIMLEASE_GUARD_READY_FILE="$ready_file"
    SIMLEASE_GUARD_ACK_FILE="$acknowledged_file"
    SIMLEASE_GUARD_RELEASE_FILE="$release_file"
    trap 'guard_cleanup "$SIMLEASE_GUARD_METADATA_PATH" "$SIMLEASE_GUARD_TOKEN_HASH" "$SIMLEASE_GUARD_READY_FILE" "$SIMLEASE_GUARD_ACK_FILE" "$SIMLEASE_GUARD_RELEASE_FILE"' EXIT
    trap 'exit 0' INT TERM HUP

    write_metadata \
        "$metadata" "$udid" "$device_name" "$owner" "$purpose" "$hashed_token" \
        "$acquired_epoch" "$expires_epoch" "$ttl_seconds" "$PPID" "$$" "$derived_data_path" \
        "$booted_by_simlease" "$([[ "$booted_by_simlease" == "true" ]] && printf 'booting' || printf 'leased')" \
        "$guard_label"

    if [[ "$booted_by_simlease" == "true" ]]; then
        boot_device "$udid" "$device_name" || exit 1
        jq '.lifecycleState = "leased"' "$metadata" > "${metadata}.booted.$$"
        mv "${metadata}.booted.$$" "$metadata"
    fi
    # Start the handshake clock only after booting; a Simulator boot can take
    # far longer than the acknowledgement window.
    acknowledgement_deadline=$(( $(date +%s) + 5 ))
    : > "$ready_file"

    while [[ ! -f "$acknowledged_file" ]]; do
        [[ "$(date +%s)" -lt "$acknowledgement_deadline" ]] || exit 1
        sleep 0.1
    done

    while true; do
        [[ ! -f "$release_file" ]] || break
        [[ -f "$metadata" ]] || break
        current_expiry="$(jq -r '.expiresAtEpoch // 0' "$metadata" 2>/dev/null || printf '0')"
        [[ "$current_expiry" =~ ^[0-9]+$ ]] || break
        [[ "$(date +%s)" -lt "$current_expiry" ]] || break
        sleep 1
    done
}

launchd_guard_entry() {
    local guard_label="$1"
    local udid="$2"
    local exit_status
    shift 2

    set +e
    lockf -t 0 -k "$(lock_path_for_udid "$udid")" \
        "$SCRIPT_PATH" __guard "$udid" "$@" "$guard_label"
    exit_status=$?
    set -e

    # `launchctl submit` creates a keep-alive job. Removing it here makes the
    # job one-shot while still allowing launchd to own it across tool calls.
    remove_launchd_job "$guard_label"
    return "$exit_status"
}

try_acquire_device() {
    local udid="$1"
    local device_name="$2"
    local owner="$3"
    local purpose="$4"
    local ttl_seconds="$5"
    local output_json="$6"
    local booted_by_simlease="${7:-false}"
    local serve_sim_already_running=false
    local token
    local hashed_token
    local acquired_epoch
    local expires_epoch
    local derived_data_path
    local ready_file
    local acknowledged_file
    local guard_label
    local -a guard_environment
    local runtime_script
    local handshake_attempts
    local slim_state='n/a'
    local _attempt

    remove_metadata_if_stale "$udid"
    if active_serve_sim_state "$udid" >/dev/null; then
        serve_sim_already_running=true
    fi
    token="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    hashed_token="$(token_hash "$token")"
    acquired_epoch="$(date +%s)"
    expires_epoch=$(( acquired_epoch + ttl_seconds ))
    derived_data_path="${DERIVED_DATA_ROOT}/$(workspace_key)/${udid}"
    ready_file="${HANDSHAKE_DIR}/${hashed_token}.ready"
    acknowledged_file="${HANDSHAKE_DIR}/${hashed_token}.ack"
    guard_label="com.simlease.guard.${hashed_token:0:32}"
    runtime_script="$(install_runtime_script)"
    rm -f "$ready_file" "$acknowledged_file" "${SIGNAL_DIR}/${hashed_token}.release"

    guard_environment=(
        "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
        "SIMLEASE_DIR=${LEASE_ROOT}"
        "SIMLEASE_WORKSPACE=${PROJECT_ROOT}"
        "SIMLEASE_RUNTIME_DIR=${RUNTIME_ROOT}"
    )
    if [[ -n "${SIMLEASE_TEST_DEVICE_STATE_DIR:-}" ]]; then
        guard_environment+=("SIMLEASE_TEST_DEVICE_STATE_DIR=${SIMLEASE_TEST_DEVICE_STATE_DIR}")
        guard_environment+=("SIMLEASE_TEST_BOOT_DELAY_SECONDS=${SIMLEASE_TEST_BOOT_DELAY_SECONDS:-0}")
    fi
    handshake_attempts="${SIMLEASE_ACQUIRE_HANDSHAKE_ATTEMPTS:-1800}"
    if is_android_id "$udid"; then
        guard_environment+=(
            "HOME=${HOME}"
            "ANDROID_SDK_ROOT=${ANDROID_SDK}"
            "SIMLEASE_ANDROID_WRITABLE=${SIMLEASE_ANDROID_WRITABLE:-false}"
            "SIMLEASE_ANDROID_WINDOW=${SIMLEASE_ANDROID_WINDOW:-false}"
            "SIMLEASE_ANDROID_EXTRA_ARGS=${SIMLEASE_ANDROID_EXTRA_ARGS:-}"
            "SIMLEASE_ANDROID_BOOT_TIMEOUT_SECONDS=${ANDROID_BOOT_TIMEOUT_SECONDS}"
        )
        [[ -z "${ANDROID_AVD_HOME:-}" ]] || guard_environment+=("ANDROID_AVD_HOME=${ANDROID_AVD_HOME}")
        [[ -z "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" ]] || guard_environment+=(
            "SIMLEASE_ANDROID_TEST_STATE_DIR=${SIMLEASE_ANDROID_TEST_STATE_DIR}"
            "SIMLEASE_TEST_ANDROID_BOOT_FAILS=${SIMLEASE_TEST_ANDROID_BOOT_FAILS:-false}"
        )
        # A cold emulator boot takes minutes, far longer than a Simulator boot.
        handshake_attempts=$(( ANDROID_BOOT_TIMEOUT_SECONDS * 20 + 1200 ))
    fi

    if ! launchctl submit -l "$guard_label" -o /dev/null -e /dev/null -- \
        /usr/bin/env "${guard_environment[@]}" \
        "$runtime_script" __launchd-guard "$guard_label" \
        "$udid" "$device_name" "$owner" "$purpose" "$hashed_token" \
        "$acquired_epoch" "$expires_epoch" "$ttl_seconds" "$derived_data_path" "$booted_by_simlease"; then
        return 1
    fi

    for _attempt in $(seq 1 "$handshake_attempts"); do
        if [[ -f "$ready_file" ]]; then
            # Save the token before acknowledging: if it cannot be saved, the
            # unacknowledged guard gives the device back instead of leaking it.
            if [[ -n "${SIMLEASE_TOKEN_FILE_OUT:-}" ]] \
                && ! ( umask 077; printf '%s\n' "$token" > "$SIMLEASE_TOKEN_FILE_OUT" ) 2>/dev/null; then
                remove_launchd_job "$guard_label"
                rm -f "$ready_file"
                fail "could not write the token to '${SIMLEASE_TOKEN_FILE_OUT}'"
            fi
            : > "$acknowledged_file"
            is_android_id "$udid" || slim_state="$(ensure_slim "$udid" "$device_name")"
            if [[ "$output_json" == "true" ]] && is_android_id "$udid"; then
                jq -n \
                    --arg token "$token" \
                    --arg serial "$udid" \
                    --arg avd "$device_name" \
                    --arg owner "$owner" \
                    --arg purpose "$purpose" \
                    --arg expiresAt "$(utc_timestamp "$expires_epoch")" \
                    --argjson expiresAtEpoch "$expires_epoch" \
                    --argjson port "${udid#emulator-}" \
                    --argjson writable "${SIMLEASE_ANDROID_WRITABLE:-false}" \
                    '{platform:"android",token:$token,udid:$serial,serial:$serial,deviceName:$avd,avd:$avd,port:$port,grpcPort:($port+3000),writable:$writable,owner:$owner,purpose:$purpose,expiresAt:$expiresAt,expiresAtEpoch:$expiresAtEpoch,bootedBySimLease:true}'
            elif [[ "$output_json" == "true" ]]; then
                jq -n \
                    --arg token "$token" \
                    --arg udid "$udid" \
                    --arg deviceName "$device_name" \
                    --arg owner "$owner" \
                    --arg purpose "$purpose" \
                    --arg derivedDataPath "$derived_data_path" \
                    --arg expiresAt "$(utc_timestamp "$expires_epoch")" \
                    --arg slim "$slim_state" \
                    --arg keptServices "$(kept_services)" \
                    --argjson bootedBySimLease "$booted_by_simlease" \
                    --argjson serveSimAlreadyRunning "$serve_sim_already_running" \
                    --argjson expiresAtEpoch "$expires_epoch" \
                    '{platform:"ios",token:$token,udid:$udid,deviceName:$deviceName,owner:$owner,purpose:$purpose,derivedDataPath:$derivedDataPath,expiresAt:$expiresAt,expiresAtEpoch:$expiresAtEpoch,bootedBySimLease:$bootedBySimLease,serveSimAlreadyRunning:$serveSimAlreadyRunning,slim:$slim,keptServices:$keptServices}'
            elif is_android_id "$udid"; then
                printf 'Emulator lease acquired\n'
                printf '  AVD:          %s (%s)\n' "$device_name" "$([[ "${SIMLEASE_ANDROID_WRITABLE:-false}" == "true" ]] && printf 'writable' || printf 'read-only')"
                printf '  Serial:       %s\n' "$udid"
                printf '  gRPC port:    %s\n' "$(( ${udid#emulator-} + 3000 ))"
                printf '  Owner:        %s\n' "$owner"
                printf '  Purpose:      %s\n' "${purpose:--}"
                printf '  Expires:      %s\n' "$(utc_timestamp "$expires_epoch")"
                printf '  Token:        %s\n' "$token"
            else
                printf 'Simulator lease acquired\n'
                printf '  Device:       %s\n' "$device_name"
                printf '  UUID:         %s\n' "$udid"
                printf '  Owner:        %s\n' "$owner"
                printf '  Purpose:      %s\n' "${purpose:--}"
                printf '  Expires:      %s\n' "$(utc_timestamp "$expires_epoch")"
                printf '  DerivedData:  %s\n' "$derived_data_path"
                printf '  Started:      %s\n' "$booted_by_simlease"
                printf '  Slim:         %s\n' "$slim_state"
                printf '  serve-sim:    %s\n' "$serve_sim_already_running"
                printf '  Token:        %s\n' "$token"
            fi
            return 0
        fi

        if ! launchd_job_is_loaded "$guard_label"; then
            rm -f "$ready_file" "$acknowledged_file"
            return 1
        fi
        if [[ "$_attempt" -gt 100 ]] && ! launchd_job_is_running "$guard_label"; then
            remove_launchd_job "$guard_label"
            rm -f "$ready_file" "$acknowledged_file"
            return 1
        fi
        sleep 0.05
    done

    remove_launchd_job "$guard_label"
    rm -f "$ready_file" "$acknowledged_file"
    return 1
}

scale_and_acquire() {
    local owner="$1"
    local purpose="$2"
    local requested_device="$3"
    local ttl_seconds="$4"
    local output_json="$5"
    local capacity
    local udid
    local device_name

    # Another task may have released a booted device before this process obtained the pool lock.
    while IFS=$'\t' read -r udid device_name; do
        [[ -n "$udid" ]] || continue
        [[ -z "$requested_device" || "$requested_device" == "$udid" ]] || continue
        [[ -n "$requested_device" ]] || ! is_pinned "$udid" || continue
        if try_acquire_device "$udid" "$device_name" "$owner" "$purpose" "$ttl_seconds" "$output_json" false; then
            return 0
        fi
    done < <(booted_devices)

    capacity="$(capacity_json)"
    [[ "$(jq -r '.canBootAnother' <<< "$capacity")" == "true" ]] || return 1
    while IFS=$'\t' read -r udid device_name; do
        [[ -n "$udid" ]] || continue
        [[ -z "$requested_device" || "$requested_device" == "$udid" ]] || continue
        [[ -n "$requested_device" ]] || ! is_pinned "$udid" || continue
        if try_acquire_device "$udid" "$device_name" "$owner" "$purpose" "$ttl_seconds" "$output_json" true; then
            return 0
        fi
    done < <(shutdown_devices)
    return 1
}

# Every Android lease boots its own emulator instance on a free port. Shared
# AVDs run read-only, so any number of leases can use the same AVD at once.
# Exit status: 0 leased, 1 no capacity or no free port (retry), 2 boot failed.
android_scale_and_acquire() {
    local owner="$1"
    local purpose="$2"
    local avd="$3"
    local ttl_seconds="$4"
    local output_json="$5"
    local capacity
    local port
    local serial
    local log_file

    capacity="$(capacity_json android)"
    [[ "$(jq -r '.canBootAnother' <<< "$capacity")" == "true" ]] || return 1
    if [[ "${SIMLEASE_ANDROID_WRITABLE:-false}" == "true" ]] && android_avd_is_running "$avd"; then
        return 1
    fi
    for (( port = ANDROID_FIRST_PORT; port <= ANDROID_LAST_PORT; port += 2 )); do
        serial="emulator-${port}"
        probe_lock_is_free "$serial" || continue
        [[ ! -f "$(metadata_path_for_udid "$serial")" ]] || continue
        ! android_port_in_use "$port" || continue
        if try_acquire_device "$serial" "$avd" "$owner" "$purpose" "$ttl_seconds" "$output_json" true; then
            return 0
        fi
        log_file="${LEASE_ROOT}/android-logs/${serial}.log"
        printf 'simlease: emulator %s (AVD %s) did not boot\n' "$serial" "$avd" >&2
        [[ ! -s "$log_file" ]] || tail -5 "$log_file" >&2
        return 2
    done
    return 1
}

acquire_android_lease() {
    local owner="$1"
    local purpose="$2"
    local avd="$3"
    local ttl_seconds="$4"
    local wait_seconds="$5"
    local output_json="$6"
    local started_at
    local status
    local reported=false
    local running_as

    [[ -n "$avd" ]] || avd="${SIMLEASE_ANDROID_AVD:-}"
    [[ -n "$avd" ]] || fail "--android needs --avd NAME (or SIMLEASE_ANDROID_AVD). AVDs: $(android_avds | paste -sd ' ' -)"
    android_avds | grep -qx -- "$avd" || fail "no AVD named '$avd'. AVDs: $(android_avds | paste -sd ' ' -)"
    [[ -n "${SIMLEASE_ANDROID_TEST_STATE_DIR:-}" || -x "$(android_tool emulator)" ]] \
        || fail "Android emulator not found at $(android_tool emulator); set ANDROID_SDK_ROOT"
    started_at="$(date +%s)"
    while true; do
        set +e
        # A separate pool lock: a minutes-long emulator boot must not stall iOS.
        lockf -t 0 -k "${LOCK_DIR}/android-pool.lock" "$SCRIPT_PATH" __android-scale-and-acquire \
            "$owner" "$purpose" "$avd" "$ttl_seconds" "$output_json"
        status=$?
        set -e
        [[ "$status" -ne 0 ]] || return 0
        [[ "$status" -ne 2 ]] || fail "emulator boot failed; log above"
        if [[ "$reported" == "false" ]]; then
            case "$(jq -r '.reason' <<< "$(capacity_json android)")" in
                emulator-limit) printf 'simlease: the emulator limit is reached; waiting for a lease\n' >&2 ;;
                insufficient-free-memory) printf 'simlease: not enough free memory to boot an emulator; waiting for a lease\n' >&2 ;;
                *)
                    if [[ "${SIMLEASE_ANDROID_WRITABLE:-false}" == "true" ]]; then
                        running_as="$(android_avd_running_as "$avd" || true)"
                        if [[ -n "$running_as" && "$running_as" != "$avd" ]]; then
                            printf 'simlease: AVD %s is running elsewhere as %s (two names, one AVD folder); a writable lease waits for it\n' \
                                "$avd" "$running_as" >&2
                        else
                            printf 'simlease: AVD %s is running elsewhere; a writable lease waits for it\n' "$avd" >&2
                        fi
                    fi ;;
            esac
            reported=true
        fi
        if [[ $(( $(date +%s) - started_at )) -ge "$wait_seconds" ]]; then
            status_leases >&2 || true
            fail 'no emulator could be leased'
        fi
        sleep 1
    done
}

acquire_lease() {
    local owner=""
    local purpose=""
    local requested_device=""
    local ttl_seconds="$DEFAULT_TTL_SECONDS"
    local wait_seconds=0
    local output_json=false
    local boot_if_needed=false
    local token_file=""
    local android=false
    local avd=""
    local wait_reason_reported=false
    local started_at
    local device_count
    local candidate_found
    local udid
    local device_name
    local capacity

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --android) android=true; shift ;;
            --avd) [[ $# -ge 2 ]] || fail '--avd requires an AVD name'; android=true; avd="$2"; shift 2 ;;
            --writable) export SIMLEASE_ANDROID_WRITABLE=true; shift ;;
            --keep-services) [[ $# -ge 2 ]] || fail '--keep-services requires categories'; export SIMLEASE_KEEP_SERVICES="$2"; shift 2 ;;
            --window) export SIMLEASE_ANDROID_WINDOW=true; shift ;;
            --emulator-args) [[ $# -ge 2 ]] || fail '--emulator-args requires a value'; export SIMLEASE_ANDROID_EXTRA_ARGS="$2"; shift 2 ;;
            --owner) [[ $# -ge 2 ]] || fail '--owner requires a value'; owner="$2"; shift 2 ;;
            --purpose) [[ $# -ge 2 ]] || fail '--purpose requires a value'; purpose="$2"; shift 2 ;;
            --device) [[ $# -ge 2 ]] || fail '--device requires a UUID'; requested_device="$2"; shift 2 ;;
            --ttl) [[ $# -ge 2 ]] || fail '--ttl requires seconds'; ttl_seconds="$2"; shift 2 ;;
            --wait) [[ $# -ge 2 ]] || fail '--wait requires seconds'; wait_seconds="$2"; shift 2 ;;
            --boot-if-needed) boot_if_needed=true; shift ;;
            --token-file) [[ $# -ge 2 ]] || fail '--token-file requires a path'; token_file="$2"; shift 2 ;;
            # Compatibility with v0.2.0. Active serve-sim helpers no longer
            # block acquisition, so this former opt-in flag is now a no-op.
            --allow-active-serve-sim) shift ;;
            --json) output_json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            *) fail "unknown acquire option '$1'" ;;
        esac
    done

    [[ -n "$owner" ]] || fail 'acquire requires --owner NAME'
    [[ "$owner" != *$'\n'* ]] || fail '--owner must be one line'
    [[ "$purpose" != *$'\n'* ]] || fail '--purpose must be one line'
    require_positive_integer '--ttl' "$ttl_seconds"
    require_nonnegative_integer '--wait' "$wait_seconds"
    [[ "$android" == "true" ]] || check_keep_services
    initialize_directories
    if [[ -n "$token_file" ]]; then
        prepare_token_file "$token_file"
        # Exported so the __scale-and-acquire child process writes it too.
        export SIMLEASE_TOKEN_FILE_OUT="$token_file"
    fi
    if [[ "$android" == "true" ]]; then
        [[ -z "$requested_device" ]] || fail '--device is for Simulators; use --avd NAME for an emulator'
        acquire_android_lease "$owner" "$purpose" "$avd" "$ttl_seconds" "$wait_seconds" "$output_json"
        return
    fi
    [[ "${SIMLEASE_ANDROID_WRITABLE:-false}" != "true" && "${SIMLEASE_ANDROID_WINDOW:-false}" != "true" ]] \
        || fail '--writable and --window need --android'
    started_at="$(date +%s)"

    while true; do
        device_count=0
        candidate_found=false
        while IFS=$'\t' read -r udid device_name; do
            [[ -n "$udid" ]] || continue
            device_count=$(( device_count + 1 ))
            if [[ -n "$requested_device" && "$requested_device" != "$udid" ]]; then
                continue
            fi
            [[ -n "$requested_device" ]] || ! is_pinned "$udid" || continue
            candidate_found=true
            if try_acquire_device "$udid" "$device_name" "$owner" "$purpose" "$ttl_seconds" "$output_json"; then
                return 0
            fi
        done < <(booted_devices)

        if [[ "$boot_if_needed" == "true" ]]; then
            if lockf -t 0 -k "$POOL_LOCK_PATH" "$SCRIPT_PATH" __scale-and-acquire \
                "$owner" "$purpose" "$requested_device" "$ttl_seconds" "$output_json"; then
                return 0
            fi
            if [[ "$wait_reason_reported" == "false" ]]; then
                capacity="$(capacity_json)"
                case "$(jq -r '.reason' <<< "$capacity")" in
                    insufficient-free-memory)
                        printf 'simlease: not enough free memory to boot another Simulator; waiting for a lease\n' >&2 ;;
                    booted-simulator-limit)
                        printf 'simlease: the safe booted Simulator limit is reached; waiting for a lease\n' >&2 ;;
                    memory-pressure-unavailable)
                        printf 'simlease: memory pressure could not be measured safely; waiting for a lease\n' >&2 ;;
                esac
                wait_reason_reported=true
            fi
        fi

        if [[ "$boot_if_needed" != "true" ]]; then
            [[ "$device_count" -gt 0 ]] || fail 'no available booted simulators were found'
            [[ "$candidate_found" == "true" ]] || fail "requested simulator '$requested_device' is not booted and available"
        fi
        if [[ $(( $(date +%s) - started_at )) -ge "$wait_seconds" ]]; then
            status_leases >&2 || true
            fail 'all matching simulators are currently leased'
        fi
        sleep 1
    done
}

status_json() {
    local devices_file
    local result_file
    local udid
    local device_name
    local metadata
    local booted
    local state
    local lease_json
    local serve_sim_active
    local entry
    local capacity

    initialize_directories
    devices_file="$(mktemp "${TMPDIR:-/tmp}/simlease-devices.XXXXXX")"
    result_file="$(mktemp "${TMPDIR:-/tmp}/simlease-status.XXXXXX")"
    while IFS=$'\t' read -r udid device_name; do
        [[ -n "$udid" ]] || continue
        printf '%s\t%s\ttrue\n' "$udid" "$device_name"
    done < <(booted_devices) > "$devices_file"

    for metadata in "$LEASE_DIR"/*.json; do
        [[ -f "$metadata" ]] || continue
        udid="$(jq -r '.udid // empty' "$metadata" 2>/dev/null || true)"
        device_name="$(jq -r '.deviceName // "Unknown simulator"' "$metadata" 2>/dev/null || true)"
        [[ -n "$udid" ]] || continue
        if ! awk -F '\t' -v wanted="$udid" '$1 == wanted { found=1 } END { exit !found }' "$devices_file"; then
            # A leased emulator is always running: its lease booted it.
            printf '%s\t%s\t%s\n' "$udid" "$device_name" "$(is_android_id "$udid" && printf 'true' || printf 'false')" >> "$devices_file"
        fi
    done

    printf '[]\n' > "$result_file"
    while IFS=$'\t' read -r udid device_name booted; do
        [[ -n "$udid" ]] || continue
        metadata="$(metadata_path_for_udid "$udid")"
        remove_metadata_if_stale "$udid"
        serve_sim_active=false
        if active_serve_sim_state "$udid" >/dev/null; then
            serve_sim_active=true
        fi
        if [[ -f "$metadata" ]]; then
            state='leased'
            lease_json="$(jq 'del(.tokenHash)' "$metadata")"
        elif probe_lock_is_free "$udid"; then
            state='free'
            lease_json='null'
        else
            state='busy-unknown-owner'
            lease_json='null'
        fi
        entry="$(jq -n \
            --arg udid "$udid" \
            --arg deviceName "$device_name" \
            --arg state "$state" \
            --argjson booted "$booted" \
            --argjson lease "$lease_json" \
            --argjson serveSimActive "$serve_sim_active" \
            '{udid:$udid,deviceName:$deviceName,booted:$booted,state:$state,lease:$lease,serveSimActive:$serveSimActive}')"
        jq --argjson entry "$entry" '. + [$entry]' "$result_file" > "${result_file}.next"
        mv "${result_file}.next" "$result_file"
    done < "$devices_file"

    capacity="$(capacity_json)"
    jq -n --arg leaseDirectory "$LEASE_ROOT" --slurpfile devices "$result_file" --argjson capacity "$capacity" \
        --argjson androidCapacity "$(capacity_json android)" \
        '{leaseDirectory:$leaseDirectory,capacity:$capacity,androidCapacity:$androidCapacity,devices:$devices[0]}'
    rm -f "$devices_file" "$result_file"
}

status_leases() {
    local output_json=false
    if [[ "${1:-}" == '--json' ]]; then
        output_json=true
        shift
    fi
    [[ $# -eq 0 ]] || fail "unknown status option '$1'"

    if [[ "$output_json" == "true" ]]; then
        status_json
        return
    fi

    status_json | jq -r '
        if (.devices | length) == 0 then
            "No booted simulators or active leases.\n" +
            "Capacity: \(.capacity.freeMemoryMB) MB free; can boot another: \(.capacity.canBootAnother) (\(.capacity.reason))\n" +
            "Emulators: \(.androidCapacity.bootedSimulators)/\(.androidCapacity.maxBootedSimulators) running; can boot another: \(.androidCapacity.canBootAnother) (\(.androidCapacity.reason))"
        else
            (["STATE\tDEVICE\tUUID\tSERVE-SIM\tOWNER\tPURPOSE\tEXPIRES"] +
             [.devices[] |
                [
                    .state,
                    .deviceName,
                    .udid,
                    (if .serveSimActive then "running" else "-" end),
                    (.lease.owner // "-"),
                    (.lease.purpose // "-"),
                    (.lease.expiresAt // "-")
                ] | @tsv] +
             ["Capacity: \(.capacity.freeMemoryMB) MB free; \(.capacity.bootedSimulators)/\(.capacity.maxBootedSimulators) booted; can boot another: \(.capacity.canBootAnother) (\(.capacity.reason))",
              "Emulators: \(.androidCapacity.bootedSimulators)/\(.androidCapacity.maxBootedSimulators) running; can boot another: \(.androidCapacity.canBootAnother) (\(.androidCapacity.reason))"]) | .[]
        end'
}

renew_by_hash() {
    local hashed_token="$1"
    local ttl_override="${2:-}"
    local metadata
    local ttl_seconds
    local expires_epoch
    local temporary

    metadata="$(find_metadata_by_token_hash "$hashed_token")" || return 1
    metadata_guard_is_alive "$metadata" || return 1
    ttl_seconds="${ttl_override:-$(jq -r '.ttlSeconds // 3600' "$metadata")}"
    require_positive_integer '--ttl' "$ttl_seconds"
    expires_epoch=$(( $(date +%s) + ttl_seconds ))
    temporary="${metadata}.renew.$$"
    jq \
        --arg expiresAt "$(utc_timestamp "$expires_epoch")" \
        --argjson expiresAtEpoch "$expires_epoch" \
        --argjson ttlSeconds "$ttl_seconds" \
        '.expiresAt=$expiresAt | .expiresAtEpoch=$expiresAtEpoch | .ttlSeconds=$ttlSeconds' \
        "$metadata" > "$temporary"
    # While jq ran, a release may have removed this lease and a new lease may
    # have taken the same device file. Never write the old lease back over it.
    if ! jq -e --arg tokenHash "$hashed_token" '.tokenHash == $tokenHash' "$metadata" >/dev/null 2>&1; then
        rm -f "$temporary"
        return 1
    fi
    mv "$temporary" "$metadata"
    printf '%s\n' "$metadata"
}

token_from_file() {
    local file="$1"
    local token=""
    [[ -f "$file" ]] || fail "token file '$file' does not exist"
    IFS= read -r token < "$file" || true
    [[ -n "$token" ]] || fail "token file '$file' is empty"
    printf '%s\n' "$token"
}

# Refuses a token file that still holds a live lease's token: overwriting it
# would lose the only copy and leak that lease until its TTL runs out.
prepare_token_file() {
    local file="$1"
    local previous=""
    local metadata
    if [[ -s "$file" ]]; then
        IFS= read -r previous < "$file" || true
        if [[ -n "$previous" ]] \
            && metadata="$(find_metadata_by_token_hash "$(token_hash "$previous")")" \
            && metadata_guard_is_alive "$metadata"; then
            fail "token file '$file' still holds an active lease on $(jq -r '.deviceName' "$metadata"); release it first"
        fi
    fi
    ( umask 077; : > "$file" ) 2>/dev/null || fail "cannot write token file '$file'"
}

# Renews a lease at a third of its TTL for as long as `watched_pid` runs.
# `exec` replaces the simlease shell with the command under the same PID, so
# this renewer (its child) outlives the replacement and watches that PID.
keep_lease_alive() {
    local hashed_token="$1"
    local watched_pid="$2"
    local interval="$3"
    local waited=0
    while kill -0 "$watched_pid" 2>/dev/null; do
        sleep 1
        waited=$(( waited + 1 ))
        [[ "$waited" -ge "$interval" ]] || continue
        waited=0
        # An exited command that its parent has not reaped yet is a zombie.
        [[ "$(ps -o stat= -p "$watched_pid" 2>/dev/null || true)" != Z* ]] || return 0
        renew_by_hash "$hashed_token" >/dev/null 2>&1 || return 0
    done
}

renew_lease() {
    local token=""
    local ttl_seconds=""
    local output_json=false
    local hashed_token
    local metadata

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token) [[ $# -ge 2 ]] || fail '--token requires a value'; token="$2"; shift 2 ;;
            --token-file) [[ $# -ge 2 ]] || fail '--token-file requires a path'; token="$(token_from_file "$2")" || exit 1; shift 2 ;;
            --ttl) [[ $# -ge 2 ]] || fail '--ttl requires seconds'; ttl_seconds="$2"; shift 2 ;;
            --json) output_json=true; shift ;;
            *) fail "unknown renew option '$1'" ;;
        esac
    done
    [[ -n "$token" ]] || fail 'renew requires --token TOKEN'
    initialize_directories
    hashed_token="$(token_hash "$token")"
    metadata="$(renew_by_hash "$hashed_token" "$ttl_seconds")" || fail 'lease token is invalid or no longer active'
    if [[ "$output_json" == "true" ]]; then
        jq 'del(.tokenHash)' "$metadata"
    else
        printf 'Simulator lease renewed until %s\n' "$(jq -r '.expiresAt' "$metadata")"
    fi
}

release_lease() {
    local token=""
    local output_json=false
    local hashed_token
    local metadata
    local udid
    local device_name
    local release_file
    local booted_by_simlease
    local _attempt

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token) [[ $# -ge 2 ]] || fail '--token requires a value'; token="$2"; shift 2 ;;
            --token-file) [[ $# -ge 2 ]] || fail '--token-file requires a path'; token="$(token_from_file "$2")" || exit 1; shift 2 ;;
            --json) output_json=true; shift ;;
            *) fail "unknown release option '$1'" ;;
        esac
    done
    [[ -n "$token" ]] || fail 'release requires --token TOKEN'
    initialize_directories
    hashed_token="$(token_hash "$token")"
    metadata="$(find_metadata_by_token_hash "$hashed_token")" || fail 'lease token is invalid or no longer active'
    udid="$(jq -r '.udid' "$metadata")"
    device_name="$(jq -r '.deviceName' "$metadata")"
    booted_by_simlease="$(jq -r '.bootedBySimLease // false' "$metadata")"
    release_file="${SIGNAL_DIR}/${hashed_token}.release"
    : > "$release_file"

    for _attempt in $(seq 1 300); do
        [[ ! -f "$metadata" ]] && break
        sleep 0.1
    done
    remove_metadata_if_stale "$udid"
    if [[ -f "$metadata" ]]; then
        fail "lease guard did not release simulator '$udid' in time"
    fi

    if [[ "$output_json" == "true" ]]; then
        jq -n --arg udid "$udid" --arg deviceName "$device_name" --argjson shutDown "$booted_by_simlease" \
            '{released:true,udid:$udid,deviceName:$deviceName,shutDown:$shutDown}'
    else
        if is_android_id "$udid"; then
            printf 'Released emulator lease for %s (%s) and stopped the emulator\n' "$device_name" "$udid"
            return 0
        fi
        printf 'Released simulator lease for %s (%s)\n' "$device_name" "$udid"
        if [[ "$booted_by_simlease" == "true" ]]; then
            printf 'Shut down Simulator started by SimLease\n'
        fi
    fi
}

execute_with_lease() {
    local token=""
    local hashed_token
    local metadata
    local renew_interval

    case "${1:-}" in
        --token) [[ $# -ge 2 ]] || fail '--token requires a value'; token="$2" ;;
        --token-file) [[ $# -ge 2 ]] || fail '--token-file requires a path'; token="$(token_from_file "$2")" || exit 1 ;;
        *) fail 'exec requires --token TOKEN (or --token-file PATH) -- COMMAND' ;;
    esac
    shift 2
    [[ "${1:-}" == '--' ]] || fail 'exec requires -- before COMMAND'
    shift
    [[ $# -gt 0 ]] || fail 'exec requires a command'

    initialize_directories
    hashed_token="$(token_hash "$token")"
    metadata="$(renew_by_hash "$hashed_token")" || fail 'lease token is invalid or no longer active'
    export SIMLEASE_TOKEN="$token"
    if is_android_id "$(jq -r '.udid' "$metadata")"; then
        # adb, flutter and Gradle all pick up ANDROID_SERIAL.
        export ANDROID_SERIAL
        export ANDROID_AVD_NAME
        export ANDROID_EMULATOR_PORT
        export ANDROID_EMULATOR_GRPC_PORT
        ANDROID_SERIAL="$(jq -r '.udid' "$metadata")"
        ANDROID_AVD_NAME="$(jq -r '.deviceName' "$metadata")"
        ANDROID_EMULATOR_PORT="${ANDROID_SERIAL#emulator-}"
        ANDROID_EMULATOR_GRPC_PORT="$(( ANDROID_EMULATOR_PORT + 3000 ))"
    else
        export SIMULATOR_UDID
        export SIMULATOR_NAME
        export DERIVED_DATA_PATH
        SIMULATOR_UDID="$(jq -r '.udid' "$metadata")"
        SIMULATOR_NAME="$(jq -r '.deviceName' "$metadata")"
        DERIVED_DATA_PATH="$(jq -r '.derivedDataPath' "$metadata")"
    fi
    # Without this, a `flutter run` longer than the TTL loses its Simulator:
    # the guard shuts it down the moment the lease expires.
    renew_interval=$(( $(jq -r '.ttlSeconds // 3600' "$metadata") / 3 ))
    [[ "$renew_interval" -ge 1 ]] || renew_interval=1
    [[ "$renew_interval" -le 300 ]] || renew_interval=300
    keep_lease_alive "$hashed_token" "$$" "$renew_interval" </dev/null >/dev/null 2>&1 &
    exec "$@"
}

main() {
    require_command install
    require_command jq
    require_command launchctl
    require_command lockf
    require_command shasum
    require_command uuidgen

    case "${1:-}" in
        acquire) shift; acquire_lease "$@" ;;
        status|list) shift; status_leases "$@" ;;
        renew) shift; renew_lease "$@" ;;
        release) shift; release_lease "$@" ;;
        exec) shift; execute_with_lease "$@" ;;
        __guard) shift; initialize_directories; guard_lease "$@" ;;
        __launchd-guard) shift; initialize_directories; launchd_guard_entry "$@" ;;
        __cleanup-stale) shift; initialize_directories; cleanup_stale_metadata_under_lock "$@" ;;
        __scale-and-acquire) shift; initialize_directories; scale_and_acquire "$@" ;;
        __android-scale-and-acquire) shift; initialize_directories; android_scale_and_acquire "$@" ;;
        __simslim-check) check_simslim ;;
        --version|-V) printf 'simlease %s\n' "$SIMLEASE_VERSION" ;;
        -h|--help|help|'') usage ;;
        *) fail "unknown command '$1'" ;;
    esac
}

main "$@"
