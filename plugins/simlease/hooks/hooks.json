{
  "description": "Keep Simulator and emulator operations inside an active SimLease lease.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*([Xx]code|[Ss]imulator|serve[_-]sim).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/simlease_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Simulator lease"
          }
        ]
      }
    ]
  }
}
